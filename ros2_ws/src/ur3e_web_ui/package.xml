<?xml version="1.0"?>
<package format="3">
  <name>ur3e_web_ui</name>
  <version>0.1.0</version>
  <description>Browser UI for the UR3e: live 3D model, jog control, TCP pose, and Isaac rollout replay.</description>
  <maintainer email="rigon@example.com">rigon</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>ur3e_rollout_replay</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <!-- fastapi and uvicorn[standard] are pip-only on Ubuntu 22.04; install
       them with pip (user install) as described in docs/ur3e_web_ui.md -->

  <test_depend>ament_pytest</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
