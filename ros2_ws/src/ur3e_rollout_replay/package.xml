<?xml version="1.0"?>
<package format="3">
  <name>ur3e_rollout_replay</name>
  <version>0.1.0</version>
  <description>Validate and replay Isaac rollout joint targets on a UR3e through FollowJointTrajectory.</description>
  <maintainer email="rigon@example.com">rigon</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>

  <test_depend>ament_pytest</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
